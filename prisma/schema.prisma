datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RepoStatus {
  IN_PROGRESS
  COMPLETED
}

enum FileNodeType {
  FILE
  FOLDER
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Repository {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?       @db.Text
  status      RepoStatus    @default(IN_PROGRESS)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  files       FileNode[]
  activities  ActivityLog[]
}

model FileNode {
  id           String        @id @default(cuid())
  repoId       String
  parentId     String?
  type         FileNodeType
  name         String
  storagePath  String?
  mimeType     String?
  fileSize     BigInt?
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  repository   Repository    @relation(fields: [repoId], references: [id], onDelete: Cascade)
  parent       FileNode?     @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     FileNode[]    @relation("FolderTree")

  @@index([repoId, parentId, isDeleted])
}

model ActivityLog {
  id          String      @id @default(cuid())
  repoId      String
  actionType  String
  title       String
  description String?     @db.Text
  weightScore Int         @default(1)
  createdAt   DateTime    @default(now())

  repository  Repository  @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model MigrationJob {
  id          String    @id @default(cuid())
  sourcePath  String
  destPath    String
  totalFiles  Int
  movedFiles  Int       @default(0)
  currentFile String?
  status      String
  errorLog    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
